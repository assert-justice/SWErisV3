{
    "gamepad":{
        "auto_charge": true,
        "reticle_force_visible": false,
        "invert_left_x": false,
        "invert_right_x": false,
        "invert_left_y": false,
        "invert_right_y": false
    },
    "kbm":{
        "kb_aiming": true,
        "reticle_force_visible": true
    },
    "buttons":{
        "attack": {
            "buffer": 0.25,
            "mouse_buttons":["Left"],
            "gamepad_buttons": ["West"]
        },
        "fire": {
            "mouse_buttons":["Left"],
            "gamepad_buttons": ["RightShoulder"]
        },
        "charge": {
            "mouse_buttons":["Right"],
            "gamepad_axes_high":["RightTrigger"]
        },
        "dodge": {
            "buffer": 0.25,
            "keys":["Space"],
            "gamepad_buttons":["East", "LeftShoulder"]
        },
        "cast": {
            "buffer": 0.25,
            "mouse_buttons":["Middle"],
            "gamepad_buttons":[]
        },
        "use": {
            "buffer": 0.25,
            "keys":["E"],
            "gamepad_buttons":["North"]
        },
        "heal": {
            "buffer": 0.25,
            "keys":["Q"],
            "gamepad_buttons":["East"]
        },
        "quaff": {
            "buffer": 0.25,
            "keys":["F"],
            "gamepad_buttons":["North"]
        },
        "pause":{
            "keys": ["Escape"],
            "gamepad_buttons": ["Start"]
        },
        "ui_confirm":{
            "keys": ["Return", "Space"],
            "gamepad_buttons": ["South"]
        },
        "ui_cancel":{
            "keys": ["Escape"],
            "gamepad_buttons": ["East"]
        },
        "ui_left":{
            "pulse_cooldown": 0.25,
            "pulse_delay": 0.2,
            "keys": ["A","Left"],
            "gamepad_buttons": ["DPadLeft"],
            "gamepad_axes_low":["LeftX"]
        },
        "ui_right":{
            "pulse_cooldown": 0.25,
            "pulse_delay": 0.2,
            "keys": ["D","Right"],
            "gamepad_buttons": ["DPadRight"],
            "gamepad_axes_high":["LeftX"]
        },
        "ui_up":{
            "pulse_cooldown": 0.25,
            "pulse_delay": 0.2,
            "keys": ["W","Up"],
            "gamepad_buttons": ["DPadUp"],
            "gamepad_axes_low":["LeftY"]
        },
        "ui_down":{
            "pulse_cooldown": 0.25,
            "pulse_delay": 0.2,
            "keys": ["S","Down"],
            "gamepad_buttons": ["DPadDown"],
            "gamepad_axes_high":["LeftY"]
        }
    },
    "axes2":{
        "move":{
            "deadzone": 0.2,
            "x":{
                "gamepad_axes": ["LeftX"],
                "neg_keys": ["A"],
                "pos_keys": ["D"]
            },
            "y":{
                "gamepad_axes": ["LeftY"],
                "neg_keys": ["W"],
                "pos_keys": ["S"]
            }
        },
        "aim":{
            "deadzone": 0.2,
            "x":{
                "gamepad_axes": ["RightX"]
            },
            "y":{
                "gamepad_axes": ["RightY"]
            }
        }
    }
}
